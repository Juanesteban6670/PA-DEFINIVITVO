# ==============================================================================
# Cartagena Segura - Dockerfile Unificado para Despliegue en la Nube (Cloud)
# Compila Frontend (Flutter Web) + Backend (Spring Boot 3) en una sola imagen.
# ==============================================================================

# ── Stage 1: Compilar Flutter Web ─────────────────────────────────────────────
FROM --platform=linux/amd64 debian:bookworm-slim AS flutter-builder

ARG FLUTTER_VERSION=3.47.9
ARG FLUTTER_SHA256=25ed8c3c29d51a7353f2a944310b478af8214920639524b19c50a19e6c044c5a

ENV DEBIAN_FRONTEND=noninteractive
ENV FLUTTER_SUPPRESS_ANALYTICS=true

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl git libglu1-mesa unzip xz-utils zip \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL "https://storage.googleapis.com/flutter_infra_release/releases/stable/linux/flutter_linux_${FLUTTER_VERSION}-stable.tar.xz" -o /tmp/flutter.tar.xz \
    && echo "${FLUTTER_SHA256}  /tmp/flutter.tar.xz" | sha256sum -c - \
    && tar -xJf /tmp/flutter.tar.xz -C /opt \
    && rm /tmp/flutter.tar.xz \
    && git config --global --add safe.directory /opt/flutter

ENV PATH="/opt/flutter/bin:${PATH}"

WORKDIR /client
COPY client/pubspec.yaml client/pubspec.lock ./
RUN flutter config --no-analytics && flutter pub get

COPY client/ .
RUN flutter build web --release --base-href=/ --dart-define=API_BASE_URL=/api

# ── Stage 2: Compilar Backend Spring Boot con Flutter Web embebido ────────────
FROM maven:3.9.6-eclipse-temurin-21 AS backend-builder

WORKDIR /app
COPY backend/pom.xml .
RUN mvn dependency:go-offline -B

COPY backend/src ./src

# Copiar el build compilado de Flutter Web directamente a los recursos estáticos del backend
COPY --from=flutter-builder /client/build/web/ ./src/main/resources/Static/

RUN mvn clean package -DskipTests -B

# ── Stage 3: Runtime de Producción Ligero (Java 21 Alpine) ───────────────────
FROM eclipse-temurin:21-jre-alpine

WORKDIR /app

RUN mkdir -p /app/uploads && chmod 777 /app/uploads

COPY --from=backend-builder /app/target/*.jar app.jar

ENV PORT=8080
ENV UPLOAD_DIR=/app/uploads

EXPOSE 8080

ENTRYPOINT ["java", "-jar", "app.jar"]

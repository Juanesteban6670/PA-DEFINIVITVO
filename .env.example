# Local Docker Compose values only. Replace every password/secret before production.
POSTGRES_DB=cartagena_segura
POSTGRES_USER=cartagena
POSTGRES_PASSWORD=dev-only-change-this-password

MONGO_DATABASE=cartagena_segura
MONGO_ROOT_USERNAME=cartagena_admin
MONGO_ROOT_PASSWORD=dev-only-change-this-password

JWT_SECRET=local-only-change-this-secret-to-a-random-value-of-32-chars
JWT_EXPIRATION=86400000
GROQ_API_KEY=
APPS_SCRIPT_URL=

FRONTEND_URL=http://localhost:3000
BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=3000

# Used only by the optional HTTPS profile. Replace with a real DNS name.
DOMAIN=localhost
